{
  "name": "lenslet",
  "version": "1.0.68",
  "description": "Lenslet Markdown 编辑器",
  "desktopName": "lenslet.desktop",
  "author": "Lenslet",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && vite build --logLevel warn",
    "build": "npm run assets && npm run check && node scripts/build-native.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "dist:android": "node scripts/build-android.mjs",
    "start:android": "node scripts/start-android.mjs",
    "test:e2e": "node scripts/run-regressions.mjs all",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && node scripts/dist.mjs",
    "dist:win": "npm run build && node scripts/dist-win.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "test:portable": "node tests/portable-cache.mjs",
    "test:portable-bootstrap": "node tests/portable-bootstrap.mjs",
    "test:stability": "node scripts/run-regressions.mjs stability",
    "test:performance": "node scripts/run-regressions.mjs performance",
    "assets": "node scripts/build-assets.mjs restore",
    "dist:android:webview": "node scripts/build-android.mjs --system-webview"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@coderline/alphatab": "1.8.4",
    "@dprint/formatter": "0.6.0",
    "@dprint/ruff": "0.9.1",
    "@dprint/typescript": "0.96.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/snippet": "2.15.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/highlight": "1.2.5",
    "@mermaid-js/layout-elk": "1.0.1",
    "@milkdown/crepe": "7.22.2",
    "@milkdown/kit": "7.22.2",
    "@milkdown/react": "7.22.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.577.0",
    "mathlive": "0.111.1",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "mdast-util-to-markdown": "2.2.0",
    "mermaid": "12.1.0",
    "micromark-util-chunked": "2.0.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-resolve-all": "2.0.1",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.2",
    "semver": "7.7.4",
    "webdav": "5.11.0"
  },
  "devDependencies": {
    "@live-codes/clang-wasm": "0.3.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lax-sql": "0.3.0",
    "pyodide": "314.0.7",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sql.js": "1.14.2",
    "typescript": "^5.9.3",
    "unified": "11.0.5",
    "vite": "8.3.2",
    "wasmoon": "1.16.0"
  },
  "overrides": {
    "@electron/get": "5.1.0",
    "nanoid": "3.3.18",
    "lodash-es": "4.18.1",
    "sass": "1.105.1",
    "katex": "0.18.10"
  },
  "build": {
    "beforeBuild": "scripts/before-build.cjs",
    "electronDist": "node_modules/electron/dist",
    "beforePack": "scripts/before-pack.cjs",
    "appId": "com.lrj.lenslet.editor",
    "productName": "Lenslet",
    "directories": {
      "output": "release/v${version}",
      "app": "build-app"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      {
        "from": "node_modules/esbuild",
        "to": "node_modules/esbuild",
        "filter": [
          "package.json",
          "lib/main.js",
          "LICENSE.md"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png"
    },
    "linux": {
      "syncDesktopName": true,
      "artifactName": "Lenslet-${version}-${arch}.${ext}",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Lenslet",
      "executableName": "lenslet",
      "icon": "resources/icon.png"
    },
    "portable": {
      "useZip": true,
      "artifactName": "Lenslet-${version}-${arch}.exe"
    },
    "asarUnpack": [
      "resources/tools/*",
      "resources/terminal/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JJl624/Lenslet.git"
  },
  "homepage": "https://github.com/JJl624/Lenslet",
  "bugs": {
    "url": "https://github.com/JJl624/Lenslet/issues"
  }
}
